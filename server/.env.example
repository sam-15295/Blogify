NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/blogify_api
CLIENT_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2
BCRYPT_ROUNDS=10
