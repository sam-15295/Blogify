NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/blogify_api
CLIENT_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2
BCRYPT_ROUNDS=10

# Deployment: let the API also serve the built React app (single origin). Run `npm run build` at the repo root first.
SERVE_CLIENT=false
# Cookie SameSite policy for the refresh token. Keep "lax" unless the frontend is on a different site (then "none").
COOKIE_SAMESITE=lax
